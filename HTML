<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AM PEACE Overseas Services</title>
  <meta name="description" content="Overseas job placement, employment visa and work permit guidance in Hyderabad.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --navy: #0a1c35;
      --blue: #1b416b;
      --gold: #d7b36b;
      --cream: #f8f6f0;
      --text: #25354a;
      --muted: #788496;
      --border: #e8eaf0;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: "DM Sans", Arial, sans-serif; color: var(--text); line-height: 1.65; }
    a { color: inherit; text-decoration: none; }
    button, input, select, textarea { font: inherit; }
    .container { width: min(1160px, 92%); margin: auto; }
    section { padding: 75px 0; scroll-margin-top: 80px; }

    header { position: sticky; top: 0; z-index: 10; background: var(--navy); color: white; }
    .navbar { min-height: 78px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .brand { font-size: 22px; font-weight: 800; line-height: 1.2; }
    .brand span { display: block; color: var(--gold); font-size: 10px; letter-spacing: 3px; }
    nav { display: flex; gap: 20px; align-items: center; }
    nav a { font-size: 13px; font-weight: 700; }
    nav a:hover { color: var(--gold); }
    .menu-toggle { display: none; background: none; border: 0; color: white; font-size: 26px; }

    .btn { display: inline-block; border: 1px solid var(--gold); background: var(--gold); color: var(--navy); padding: 12px 20px; border-radius: 4px; font-size: 13px; font-weight: 800; cursor: pointer; }
    .btn:hover { filter: brightness(1.06); }
    .btn-dark { background: var(--navy); border-color: var(--navy); color: white; }
    .btn-outline { background: transparent; color: white; border-color: white; }

    .hero { min-height: 560px; display: flex; align-items: center; color: white; background: linear-gradient(90deg, #07172ff2, #0b254899), url("https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=1800") center/cover; }
    .hero-content { max-width: 760px; padding: 80px 0; }
    .eyebrow, .section-heading small { color: #a17b38; font-size: 11px; font-weight: 800; letter-spacing: 3px; }
    .hero h1 { font: 600 clamp(42px, 6vw, 72px)/1.15 "Playfair Display", Georgia, serif; margin: 20px 0; }
    .hero h1 span { color: var(--gold); }
    .hero p { color: #dce5f0; max-width: 650px; margin-bottom: 25px; }
    .hero-buttons { display: flex; flex-wrap: wrap; gap: 12px; }

    .trust { background: var(--gold); padding: 22px 0; }
    .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; gap: 15px; }
    .trust strong, .trust span { display: block; }
    .trust span { font-size: 12px; }

    .section-heading { text-align: center; max-width: 720px; margin: 0 auto 38px; }
    .section-heading h2, .about h2, .contact-info h2 { font: 600 clamp(30px, 4vw, 43px)/1.2 "Playfair Display", Georgia, serif; color: var(--navy); margin: 10px 0; }
    .section-heading p { color: var(--muted); }

    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .card { padding: 28px; border: 1px solid var(--border); border-radius: 9px; background: white; }
    .card h3 { color: var(--navy); margin: 10px 0; }
    .card p { color: var(--muted); font-size: 14px; }
    .icon { font-size: 28px; }

    .about { background: var(--cream); }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 45px; align-items: center; }
    .about-image { min-height: 360px; border-radius: 10px; background: url("https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=1000") center/cover; }
    .about p { color: var(--muted); margin: 12px 0; }
    .destinations { background: var(--navy); color: white; }
    .destinations .section-heading h2 { color: white; }
    .destination { min-height: 180px; display: flex; align-items: end; padding: 20px; border-radius: 8px; background: linear-gradient(transparent, #07172fee), url("https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=700") center/cover; }
    .destination h3 { color: white; }

    .job-card { border: 1px solid var(--border); border-radius: 8px; padding: 24px; }
    .job-card h3 { color: var(--navy); margin: 10px 0; }
    .job-card p { color: var(--muted); font-size: 13px; margin-bottom: 8px; }
    .job-card .btn { margin-top: 10px; }
    .search-box { background: #f4f6f9; padding: 25px; border-radius: 8px; margin-bottom: 30px; }
    .search-fields { display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 10px; margin-top: 15px; }
    input, select, textarea { width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 5px; background: white; }
    textarea { min-height: 110px; resize: vertical; }
    .search-message, .status { margin-top: 12px; font-size: 13px; }
    .status { color: #147b51; }
    .error { color: #b42318; }

    .portal { background: var(--cream); }
    .portal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 25px; }
    .portal-card { background: white; padding: 28px; border-radius: 9px; border: 1px solid var(--border); }
    .portal-card p { color: var(--muted); font-size: 14px; margin: 8px 0 18px; }
    .portal-card form { display: grid; gap: 10px; }
    .portal-card h3 { color: var(--navy); }
    .portal-card .btn { width: 100%; }
    #candidateDashboard { display: none; }

    .contact { background: #f7f8fa; }
    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 25px; }
    .contact-info { background: var(--navy); color: white; border-radius: 9px; padding: 32px; }
    .contact-info h2 { color: white; font-size: 30px; }
    .contact-info p, .contact-info a { color: #dce5f0; font-size: 14px; }
    .contact-info .contact-item { margin: 18px 0; }
    .contact-form { background: white; padding: 30px; border-radius: 9px; }
    .contact-form h3 { font: 600 27px "Playfair Display", Georgia, serif; color: var(--navy); }
    .contact-form > p { color: var(--muted); font-size: 13px; margin-bottom: 15px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .contact-form input, .contact-form select, .contact-form textarea { margin: 6px 0; }
    .contact-form button { width: 100%; margin-top: 10px; }

    footer { background: #07162b; color: #c3cedd; padding: 40px 0 20px; }
    .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 30px; }
    footer h3 { color: var(--gold); margin-bottom: 12px; }
    footer a { display: block; font-size: 13px; margin: 6px 0; }
    .copyright { border-top: 1px solid #ffffff20; margin-top: 30px; padding-top: 18px; text-align: center; font-size: 12px; }

    @media (max-width: 800px) {
      .menu-toggle { display: block; }
      nav { display: none; position: absolute; top: 78px; left: 0; right: 0; background: var(--navy); padding: 20px 4%; flex-direction: column; align-items: flex-start; }
      nav.open { display: flex; }
      .grid, .about-grid, .contact-grid, .portal-grid, .footer-grid { grid-template-columns: 1fr; }
      .search-fields { grid-template-columns: 1fr; }
    }
    @media (max-width: 520px) {
      section { padding: 55px 0; }
      .trust-grid { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; }
      .hero { min-height: 500px; }
    }
  </style>
</head>


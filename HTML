<script>
  const SESSION_KEY = "amPeaceCandidateToken";

  function toggleMenu() {
    document.getElementById("navigation").classList.toggle("open");
  }

  document.querySelectorAll("#navigation a").forEach(function(link) {
    link.addEventListener("click", function() {
      document.getElementById("navigation").classList.remove("open");
    });
  });

  function searchJobs(event) {
    event.preventDefault();

    const keyword = document.getElementById("searchKeyword").value.trim().toLowerCase();
    const country = document.getElementById("searchCountry").value;
    const category = document.getElementById("searchCategory").value;
    let count = 0;

    document.querySelectorAll(".job-card").forEach(function(card) {
      const text = card.innerText.toLowerCase();
      const countries = card.dataset.country.split(" ");
      const matches = (!keyword || text.includes(keyword)) &&
        (!country || countries.includes(country)) &&
        (!category || card.dataset.category === category);

      card.style.display = matches ? "" : "none";
      if (matches) count++;
    });

    document.getElementById("noJobs").style.display = count ? "none" : "block";
    document.getElementById("searchMessage").textContent = count + " matching sample categories found.";
  }

  function sendEnquiry(event) {
    event.preventDefault();

    const form = document.getElementById("contactEnquiryForm");
    const button = form.querySelector("button[type='submit']");
    const status = document.getElementById("enquiryStatus");

    const data = {
      name: document.getElementById("fullName").value.trim(),
      phone: document.getElementById("phone").value.trim(),
      email: document.getElementById("email").value.trim(),
      service: document.getElementById("service").value,
      country: document.getElementById("preferredCountry").value.trim(),
      message: document.getElementById("message").value.trim()
    };

    button.disabled = true;
    button.textContent = "Submitting...";
    status.className = "status";
    status.textContent = "";

    google.script.run
      .withSuccessHandler(function(result) {
        status.textContent = result.message || "Enquiry submitted successfully.";
        form.reset();
        button.disabled = false;
        button.textContent = "Submit Enquiry →";
      })
      .withFailureHandler(function(error) {
        status.className = "status error";
        status.textContent = error.message || "Unable to submit. Please try again.";
        button.disabled = false;
        button.textContent = "Submit Enquiry →";
      })
      .saveEnquiry(data);
  }

  function registerCandidate(event) {
    event.preventDefault();

    const status = document.getElementById("registerStatus");
    status.className = "status";
    status.textContent = "Registering...";

    const data = {
      name: document.getElementById("regName").value.trim(),
      phone: document.getElementById("regPhone").value.trim(),
      email: document.getElementById("regEmail").value.trim(),
      password: document.getElementById("regPassword").value
    };

    google.script.run
      .withSuccessHandler(function(result) {
        saveCandidateSession(result);
        document.getElementById("regName").form.reset();
      })
      .withFailureHandler(function(error) {
        status.className = "status error";
        status.textContent = error.message || "Registration failed.";
      })
      .registerCandidate(data);
  }

  function loginCandidate(event) {
    event.preventDefault();

    const status = document.getElementById("loginStatus");
    status.className = "status";
    status.textContent = "Signing in...";

    const data = {
      email: document.getElementById("loginEmail").value.trim(),
      password: document.getElementById("loginPassword").value
    };

    google.script.run
      .withSuccessHandler(function(result) {
        saveCandidateSession(result);
        document.getElementById("loginEmail").form.reset();
      })
      .withFailureHandler(function(error) {
        status.className = "status error";
        status.textContent = error.message || "Sign in failed.";
      })
      .loginCandidate(data);
  }

  function saveCandidateSession(result) {
    if (!result || !result.token || !result.candidate) {
      alert("Could not establish your candidate session.");
      return;
    }

    localStorage.setItem(SESSION_KEY, result.token);
    showCandidate(result.candidate);
  }

  function showCandidate(candidate) {
    document.getElementById("portalForms").style.display = "none";
    document.getElementById("candidateDashboard").style.display = "block";
    document.getElementById("candidateName").textContent = candidate.name;
    document.getElementById("candidateDetails").textContent =
      candidate.email + " · " + candidate.phone;
  }

  function logoutCandidate() {
    const token = localStorage.getItem(SESSION_KEY);
    localStorage.removeItem(SESSION_KEY);
    document.getElementById("portalForms").style.display = "grid";
    document.getElementById("candidateDashboard").style.display = "none";

    if (token) {
      google.script.run.logoutCandidate(token);
    }
  }

  function restoreCandidateSession() {
    const token = localStorage.getItem(SESSION_KEY);
    if (!token) return;

    google.script.run
      .withSuccessHandler(function(result) {
        if (result && result.candidate) {
          showCandidate(result.candidate);
        } else {
          localStorage.removeItem(SESSION_KEY);
        }
      })
      .withFailureHandler(function() {
        localStorage.removeItem(SESSION_KEY);
      })
      .getCandidateSession(token);
  }

  window.addEventListener("load", restoreCandidateSession);
</script>
